{
  "name": "sunbee-studio",
  "productName": "Sunbee Studio",
  "desktopName": "sunbee-studio.desktop",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "author": {
    "name": "Le Cong Tien",
    "email": "lecongtien.dev@gmail.com"
  },
  "description": "Sunbee Studio desktop app",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "concurrently -n vite,server -c auto \"vite\" \"npm:dev:server\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:electron": "concurrently -n server,electron -c auto \"npm:dev:server\" \"electron-vite dev\"",
    "build": "tsc -b && electron-vite build && vite build --config server.vite.config.ts",
    "package:linux": "npm run build && electron-builder --linux -c.directories.output=release/linux",
    "package:win": "npm run build && electron-builder --win -c.directories.output=release/win",
    "release:linux": "npm run build && electron-builder --linux -c.directories.output=release/linux --publish always",
    "release:win": "npm run build && electron-builder --win -c.directories.output=release/win --publish always",
    "format": "prettier --write .",
    "lint": "oxlint && eslint .",
    "lint:fast": "oxlint",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@base-ui/react": "^1.8.0",
    "@fullcalendar/react": "^7.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-table": "^9.2.8",
    "apexcharts": "^7.8.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "flatpickr": "^4.6.13",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-icu": "^2.5.0",
    "i18next-resources-to-backend": "^1.2.3",
    "input-otp": "^1.5.0",
    "jsvectormap": "^1.7.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "mammoth": "^1.13.0",
    "maplibre-gl": "^6.13.0",
    "multer": "^2.5.0",
    "openai": "^7.51.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.3",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.4",
    "react-router": "^8.4.0",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "unpdf": "^2.1.0",
    "zod": "^3.25.76",
    "zod-mcp": "npm:zod@^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsvectormap": "^1.7.0",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
