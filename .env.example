# Copy to .env for local development. Ignored by git.
# Electron (packaged build) sets these directly when it spawns the server, so this file
# only matters for `npm run dev` / `npm run dev:server` / `npm run dev:electron`.

# Port the API server listens on.
SUNBEE_PORT=4317

# Where the SQLite DB, encryption key, and logs are stored.
SUNBEE_DATA_DIR=data

# Where the built frontend (index.html + assets) is served from in production.
SUNBEE_STATIC_DIR=dist
